# For useful gitignore templates see: https://github.com/github/gitignore

# Salesforce cache
.sf/
.sfdx/
.localdevserver/
deploy-options.json

# LWC VSCode autocomplete
**/lwc/jsconfig.json

# LWC Jest coverage reports
coverage/

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Dependency directories
node_modules/

# ApexPMD cache
.pmdCache

# Eslint cache
.eslintcache

# MacOS system files
.DS_Store

# Windows system files
Thumbs.db
ehthumbs.db
[Dd]esktop.ini
$RECYCLE.BIN/

# Local environment variables
.env

# Python Salesforce Functions
**/__pycache__/
**/.venv/
**/venv/

# Apex classes with hardcoded credentials - never commit
force-app/main/default/classes/EventSync.cls*
force-app/main/default/classes/GoogleCalenderApi.cls*
force-app/main/default/classes/NewConnectCalender.cls*
force-app/main/default/classes/Integration.cls*
force-app/main/default/classes/Linkedin.cls*
force-app/main/default/classes/RealTimeLeadToSms.cls*
force-app/main/default/classes/Spoonacular.cls*
force-app/main/default/classes/WhatsappIntegrationController.cls*
force-app/main/default/classes/XEIntegration.cls*
force-app/main/default/lwc/googleMap/googleMap.js

# Nightly Apex test reports
test-results/
