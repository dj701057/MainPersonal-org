                                    <td>40000</td>
                                </tr>
                                    </tbody>
                                </table>
                            </lightning:accordionSection>
                            <lightning:accordionSection name="C" label="Industry">
                                <table>
                                    <tbody>
                                <tr>
                                    <td>Machinery</td>
                                    <td>40000</td>
                                    <td>40000</td>
                                    <td>40000</td>
                                    <td>40000</td>
                                    <td>40000</td>
                                    <td>40000</td>
                                    <td>40000</td>
