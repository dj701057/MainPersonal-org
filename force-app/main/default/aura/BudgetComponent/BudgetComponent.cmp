                            </lightning:accordionSection>
                            <lightning:accordionSection name="B" label="Trade Category">
                                <table>
                                    <tbody>
                                <tr>
                                    <td>Architect</td>
                                    <td>40000</td>
                                    <td>40000</td>
                                    <td>40000</td>
                                    <td>40000</td>
                                    <td>40000</td>
