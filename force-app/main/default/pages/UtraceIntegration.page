<apex:page controller="Utrace_integration" showHeader="true" standardStylesheets="false" sidebar="true">
    <html>
    <head>
        <title>uTrace Integration</title>
        <link rel="stylesheet" href="https://maxcdn.bootstrapcdn.com/bootstrap/3.4.1/css/bootstrap.min.css" />
        <style>
            .container {
                margin-top: 20px;
            }
            
            h2 {
                margin-bottom: 20px;
            }
        </style>
    </head>
    <body>
        <div class="container">
            <div class="row">
                <div class="col-md-4">
                    <h2>uTrace Integration</h2>
                    <apex:form >
                        <div class="form-group">
                            <label for="ipAddress">Enter IP Address:</label>
                            <apex:inputText value="{!ipAddress}" styleClass="form-control" id="ipAddress" />
                        </div>
                        <apex:commandButton value="Get IP Details" action="{!callUtrace}" reRender="OP, ResultSection" styleClass="btn btn-primary" />
                    </apex:form>
                </div>
                <div class="col-md-8">
                    <apex:outputPanel id="ResultSection">
                        <h2>Result</h2>
                        <ul class="list-group">
                            <li class="list-group-item"><strong>IP:</strong> {!result.ip}</li>
                            <li class="list-group-item"><strong>Host:</strong> {!result.host}</li>
                            <li class="list-group-item"><strong>ISP:</strong> {!result.isp}</li>
                            <li class="list-group-item"><strong>Organization:</strong> {!result.org}</li>
                            <li class="list-group-item"><strong>Region:</strong> {!result.region}</li>
                            <li class="list-group-item"><strong>Country Code:</strong> {!result.countrycode}</li>
                            <li class="list-group-item"><strong>Latitude:</strong> {!result.latitude}</li>
                            <li class="list-group-item"><strong>Longitude:</strong> {!result.longitude}</li>
                            <li class="list-group-item"><strong>Queries:</strong> {!result.queries}</li>
                        </ul>
                    </apex:outputPanel>
                </div>
            </div>
        </div>
    </body>
    </html>
</apex:page>

