<apex:page renderAs="pdf" applyHtmlTag="false" applyBodyTag="false" standardStylesheets="false" showHeader="false" controller="AccountPDFController">
        <html>
    <head>
        <style>
            @page {
                size: landscape;
                margin: 10mm; /* You can adjust the margins as needed */
            }
            body {
                font-family: Arial, Helvetica, sans-serif;
            }
            table {
                width: 100%;
                border-collapse: collapse;
            }
            th, td {
                padding: 8px;
                border-bottom: 1px solid #ddd;
                text-align: center;
            }
            th {
                background-color: #f2f2f2;
                /* Rotate table headers */
                transform: rotate(-90deg);
                transform-origin: left top;
                white-space: nowrap;
                width: 1px;
            }
            .rotate {
                width: 1px;
            }
        </style>
    </head>
    <body>
        <h1>Contact Information</h1>
        <table>
            <tr>
                <th class="rotate">First Name</th>
                <th class="rotate">Last Name</th>
                <th class="rotate">Phone</th>
            </tr>
            <apex:repeat value="{!ContactList}" var="con">
                <tr>
                    <td>{!con.FirstName}</td>
                    <td>{!con.LastName}</td>
                    <td>{!con.Phone}</td>
                </tr>
            </apex:repeat>
        </table>
    </body>
    </html>
</apex:page>